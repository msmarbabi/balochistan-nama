<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#141b2e"
    android:padding="14dp"
    android:gravity="center">

    <TextView android:id="@+id/nwName"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="اذان بعدی" android:textColor="#ffd166"
        android:textSize="17sp" android:textStyle="bold" android:gravity="center" />

    <TextView android:id="@+id/nwTime"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="--:--" android:textColor="#ffffff"
        android:textSize="40sp" android:textStyle="bold" android:gravity="center" />

    <TextView android:id="@+id/nwRemain"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#7ee0a3"
        android:textSize="13sp" android:gravity="center" />

    <TextView android:id="@+id/nwDate"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#8a8ab0"
        android:textSize="11sp" android:gravity="center" android:layout_marginTop="2dp" />

    <TextView android:id="@+id/nwCity"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="" android:textColor="#6a6a90"
        android:textSize="10sp" android:gravity="center" />
</LinearLayout>
