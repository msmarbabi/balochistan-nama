<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#141b2e"
    android:padding="14dp" android:gravity="center">

    <TextView android:id="@+id/dkText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="ذکر دلخواه" android:textColor="#ffd166"
        android:textSize="13sp" android:textStyle="bold" android:gravity="center"
        android:maxLines="2" android:ellipsize="end" />

    <TextView android:id="@+id/dkCount"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="۰ / ۱۰۰" android:textColor="#ffffff"
        android:textSize="28sp" android:textStyle="bold" android:gravity="center"
        android:layout_marginTop="4dp" />

    <TextView android:id="@+id/dkProgress"
        android:layout_width="match_parent" android:layout_height="8dp"
        android:background="#2a2a45" android:layout_marginTop="8dp" />
</LinearLayout>
